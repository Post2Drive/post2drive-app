generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountType {
  poster
  driver
  both
}

enum PlanType {
  individual
  fleet
}

enum SubscriptionStatus {
  promotional
  active
  past_due
  cancelled
  inactive
}

enum UserRole {
  owner
  member
}

enum VerificationStatus {
  not_started
  payment_pending
  pending
  failed
  manual_review
  verified
  suspended
}

enum VerificationAttemptStatus {
  awaiting_payment
  pending
  failed
  correction
  manual_review
  successful
  expired
}

enum VerificationFeeStatus {
  unpaid
  paid
  waived
}

enum JobStatus {
  open
  accepted
  in_transit
  delivered
  completed
  cancelled
}

enum PriceMode {
  fixed
  bid
}

enum BidStatus {
  active
  invalidated
}

enum ReferralStatus {
  pending
  qualified
  rejected
}

enum OpportunityStatus {
  exposed
  viewed
  bid
  accepted
  expired
  unavailable
}

enum QualificationSide {
  driver
  poster
}

enum TesterApprovalStatus {
  pending
  approved
  rejected
}

model Account {
  id   String      @id @default(cuid())
  type AccountType

  // Commercial account classification.
  planType          PlanType @default(individual)
  fleetVehicleCount Int?

  companyName   String
  companyNumber String?
  isSoleTrader  Boolean @default(false)
  country       String  @default("GB")
  currency      String  @default("GBP")
  displayId     String  @unique

  marketingConsent   Boolean   @default(false)
  marketingConsentAt DateTime?

  // Captured when the user accepts the current legal terms at signup.
  termsAcceptedAt DateTime?
  termsVersion String?

  // Optional India-market product research; not required for account access.
  marketResearch Json?

  // Anonymized account deletion workflow. Marketplace audit records may be retained without personal identifiers.
  deletionRequestedAt DateTime?

  // Verification.
  verificationStatus VerificationStatus @default(not_started)
  companyVerificationStatus VerificationStatus @default(not_started)
  companyVerificationSubmittedAt DateTime?
  companyVerifiedAt DateTime?
  // The one user on this account named as the company's responsible person.
  // Must be a user of this account whose person ID passed (User.personVerifiedAt).
  companyResponsibleUserId String?
  verifiedAt         DateTime?
  // India marketplace access is unlocked only after phone OTP verification.
  phoneVerifiedAt     DateTime?
  isTester           Boolean            @default(false)
  testerApprovalStatus TesterApprovalStatus?

  // Activity / inactivity.
  lastActivityAt DateTime  @default(now())
  inactiveSince  DateTime?

  // Promotional membership. DEPRECATED for public launch access (replaced by LaunchConfig
  // windows, 2026-11-06). Still read for the staging UK student pilot / approved testers
  // (isTester + promotionParticipant + freeEndsAt = 90-day pilot access). freeMonthsEarned,
  // extensionCount and graceUsed are no longer written; kept so older rows stay readable.
  promotionParticipant Boolean   @default(false)
  trialStartedAt       DateTime?
  trialEndsAt          DateTime?
  freeEndsAt           DateTime?
  freeMonthsEarned     Int       @default(0)
  extensionCount       Int       @default(0)
  graceUsed            Boolean   @default(false)

  // Subscription.
  subscriptionStatus    SubscriptionStatus @default(inactive)
  subscriptionPlanKey   String?
  subscriptionStartedAt DateTime?
  subscriptionEndsAt    DateTime?

  // Launch windows / driver waitlist (EXECUTION_PLAN §3–§4).
  // UK postcode area (e.g. "LS", "M", "SW"); required for driver/fleet DRIVE in the driver window.
  operatingRegion           String?
  // Joined the driver waitlist (first DRIVE evaluation in the window without room). Orders the queue.
  driverWaitlistedAt        DateTime?
  // Admitted to free driving for the driver window. Persisted so admission is never revoked by counts.
  driverAdmittedAt          DateTime?
  // Driver -> poster switch request; effective at the end of the current 7-day period.
  switchToPosterRequestedAt DateTime?

  createdAt DateTime @default(now())

  users        User[]
  qaTestAccounts QaTestAccount[]
  postedJobs   Job[]  @relation("PostedJobs")
  acceptedJobs Job[]  @relation("AcceptedJobs")
  bids         Bid[]

  vehicles Vehicle[]
  insurancePolicyReviews InsurancePolicyReview[]
  driverIdentity DriverIdentity?

  ratingsGiven    Rating[] @relation("RatingsGiven")
  ratingsReceived Rating[] @relation("RatingsReceived")

  verificationAttempts VerificationAttempt[]
  verificationFeePayments VerificationFeePayment[]


  referralsGiven   Referral[] @relation("Referrer")
  referralReceived Referral?  @relation("ReferredAccount")

  driverOpportunities DriverOpportunity[]

  qualificationSnapshots QualificationSnapshot[]
  trialCycles TrialCycle[]

  usageEvents          PlatformUsageEvent[]
  jobActivities        JobActivity[]
  subscriptionPayments SubscriptionPayment[]
  notifications        Notification[]
  uploadedIncidentEvidence IncidentEvidence[]

  blocksCreated AccountBlock[] @relation("AccountBlocksCreated")
  blocksReceived AccountBlock[] @relation("AccountBlocksReceived")
  moderationReportsFiled ModerationReport[] @relation("ModerationReportReporter")
  moderationReportsReceived ModerationReport[] @relation("ModerationReportTarget")
  moderationReportsReviewed ModerationReport[] @relation("ModerationReportReviewer")

  @@index([companyVerificationStatus])
  @@index([operatingRegion, driverWaitlistedAt])
}

model SubscriptionPayment {
  id String @id @default(cuid())

  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accountId String

  planKey     String
  // Integer amount in currency minor units: pence for GBP, cents for EUR.
  amountMinorUnits Int
  currency    String @default("GBP")

  status String @default("pending")

  provider           String?
  providerPaymentId  String? @unique
  providerCheckoutId String? @unique

  accessStartedAt DateTime?
  accessEndsAt    DateTime?

  createdAt DateTime  @default(now())
  paidAt    DateTime?

  @@index([accountId, createdAt])
  @@index([accountId, status])
}

// Launch windows (EXECUTION_PLAN §4). Single row id "global", set by an operator.
// There are NO defaults for the dates: a missing row fails closed (no free windows,
// no Month 0 gate) and is reported by /api/launch/status and the dashboard.
model LaunchConfig {
  id                  String   @id @default("global")
  posterWindowStart   DateTime
  posterWindowEnd     DateTime
  driverWindowStart   DateTime
  driverWindowEnd     DateTime
  newPosterTrialDays  Int      @default(30)
  driverWaitlistRatio Float    @default(1.0)
  updatedAt           DateTime @updatedAt
  createdAt           DateTime @default(now())
}

model PromotionConfig {
  // DEPRECATED (2026-11-06): replaced by LaunchConfig. Kept only so the table is not dropped
  // while older deployments still read it. Only the tester-application gate reads it.
  // There is one active global promotion configuration.
  id        String   @id @default("global")
  name      String   @default("Launch Promotion")
  startAt   DateTime
  endAt     DateTime
  active    Boolean  @default(true)
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

model VerificationAttempt {
  id        String  @id @default(cuid())
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accountId String

  attemptNumber Int
  // Position inside one paid cycle: 1 = paid check, 2 = free correction after the
  // first failure (10 working days), 3 = free final evidence after the second (3 working days).
  cyclePosition Int @default(1)
  // The user whose person ID this attempt checks (null on legacy attempts).
  userId String?
  // The pending fee record that charged this attempt (null when free).
  feePaymentId String?

  status VerificationAttemptStatus @default(awaiting_payment)

  // Integer fee in the account currency's minor units (pence/cents/paise).
  feeMinorUnits Int
  feeCurrency String @default("GBP")
  feeStatus VerificationFeeStatus @default(unpaid)

  submittedAt DateTime?
  startedAt   DateTime  @default(now())

  failedAt DateTime?

  // User submission deadlines.
  correctionDeadline    DateTime?
  finalEvidenceDeadline DateTime?

  completedAt DateTime?

  failureReasons Json?
  notes          String?

  createdAt DateTime @default(now())

  @@unique([accountId, attemptNumber])
  @@index([accountId, status])
}

/// One payable record per fee-bearing action (verification start, new company
/// relationship, vehicle added). Always created as "pending": only a verified
/// provider payment event may ever mark it paid. Not refundable.
model VerificationFeePayment {
  id        String  @id @default(cuid())
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accountId String

  // e.g. poster_verification, driver_verification, driver_upgrade, new_company_relationship, vehicle_added.
  action String
  // [{ code: "personAndCompany" | "driverAndFirstVehicle" | "additionalVehicle", quantity, unitMinorUnits }]
  lineItems Json
  amountMinorUnits Int
  currency String
  // Vehicles whose check this record pays for, so no vehicle is charged twice.
  vehicleIds String[] @default([])

  status String @default("pending")
  // Caller-supplied key; one action can only ever create one record.
  idempotencyKey String @unique

  provider          String?
  providerPaymentId String? @unique

  createdAt DateTime  @default(now())
  paidAt    DateTime?

  @@index([accountId, status])
}

model Rating {
  id    String @id @default(cuid())
  job   Job    @relation(fields: [jobId], references: [id])
  jobId String

  rater   Account @relation("RatingsGiven", fields: [raterId], references: [id])
  raterId String

  ratee   Account @relation("RatingsReceived", fields: [rateeId], references: [id])
  rateeId String

  stars   Int
  comment String?

  /// "completed" | "not_completed" | "disputed" (lib/ratingPolicy.ts)
  outcome    String  @default("completed")
  /// Required for 1-2 stars and for not_completed / disputed ratings.
  reasonCode String?
  /// Blind ratings: hidden from the ratee's profile until this time.
  visibleAfter DateTime @default(now())

  createdAt DateTime @default(now())

  @@unique([jobId, raterId])
  @@index([rateeId, visibleAfter])
}

model Vehicle {
  id        String  @id @default(cuid())
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accountId String

  vehicleType String
  regPlate    String
  registrationRegion String?

  ownershipType String?
  make          String?
  model         String?
  mamKg         Int?

  v5cDocumentUrl       String?
  insuranceDocumentUrl String?
  operatorLicenceNo    String?

  verificationStatus VerificationStatus @default(not_started)
  verifiedAt         DateTime?

  motValidUntil       DateTime?
  insuranceValidUntil DateTime?

  // Ownership and insurance evidence checked at admin approval (EXECUTION_PLAN §6).
  registeredKeeperType      String? // company | individual
  registeredKeeperName      String?
  leaseAgreementUrl         String?
  insurancePolicyholderName String?
  insuranceCoverType        String? // hire_and_reward | fleet | other
  insurancePolicyNumber     String?

  // Admin review outcome. A rejection opens a free correction window.
  reviewedAt         DateTime?
  rejectionReason    String?
  rejectionCount     Int       @default(0)
  correctionDeadline DateTime?

  // Pending 0.50 fee for a vehicle beyond the first (never marked paid here).
  // Interim storage until the shared verification-fee record from #176 lands.

  jobDriverAssignments JobDriverAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([regPlate])
  @@index([accountId])
  @@index([verificationStatus, createdAt])
}

/// One insurance policy reviewed once per account; later vehicles on the same
/// policy (same policyholder + policy number) show it as already reviewed.
model InsurancePolicyReview {
  id        String  @id @default(cuid())
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accountId String

  policyKey        String
  policyholderName String
  policyNumber     String
  coverType        String
  reviewedBy       String
  reviewedAt       DateTime @default(now())

  @@unique([accountId, policyKey])
}

/// The one verified person who drives for an account. The licence number is
/// stored only as a keyed hash (unique across accounts) plus its last 4 characters.
model DriverIdentity {
  id        String  @id @default(cuid())
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accountId String  @unique

  licenceHash  String @unique
  licenceLast4 String

  createdAt DateTime @default(now())
}

/// Who drives a matched job and in which vehicle. Fleets declare it per job;
/// individual drivers get their own identity and approved vehicle recorded.
model JobDriverAssignment {
  id    String @id @default(cuid())
  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  jobId String @unique

  accountId String

  vehicle         Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  vehicleId       String?
  vehicleRegPlate String
  vehicleType     String

  driverName   String
  licenceHash  String?
  licenceLast4 String?
  source       String // fleet_declared | account_driver

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([accountId])
}

model User {
  id        String  @id @default(cuid())
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accountId String

  name         String
  email          String?   @unique
  emailVerifiedAt DateTime?
  phone          String
  // Normalised E.164 form of `phone` (e.g. +919876543210) for lookups such as
  // India phone login; null when the stored number can't be normalised.
  phoneE164      String?
  passwordHash   String
  // Incremented after credential changes to revoke every previously issued JWT session.
  sessionVersion    Int       @default(0)
  passwordChangedAt DateTime?

  role UserRole @default(owner)

  // Set when this user's person ID check passes (verification provider event).
  personVerifiedAt DateTime?

  createdAt DateTime @default(now())

  resetTokens            PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]

  @@index([phoneE164])
}

model EmailVerificationToken {
  id String @id @default(cuid())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  tokenHash String   @unique
  expiresAt   DateTime
  usedAt      DateTime?
  lastSentAt  DateTime?

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model PasswordResetToken {
  id     String @id @default(cuid())
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  tokenHash  String   @unique
  expiresAt  DateTime
  lastSentAt DateTime?

  createdAt DateTime @default(now())
}

model Job {
  id String @id @default(cuid())

  poster   Account @relation("PostedJobs", fields: [posterId], references: [id])
  posterId String

  pickup    String
  pickupLat Float?
  pickupLng Float?

  dropoff    String
  dropoffLat Float?
  dropoffLng Float?

  jobDate       DateTime
  pickupTime    String?
  dropoffTime   String?
  pickupTimeZone String?
  dropoffTimeZone String?

  vehicleType String

  weightKg   Float?
  dimensions String?

  crossBorder Boolean @default(false)

  price        Float
  pricePerMile Float?

  currency  String    @default("GBP")
  priceMode PriceMode @default(fixed)

  notes String?

  status JobStatus @default(open)

  acceptedBy   Account? @relation("AcceptedJobs", fields: [acceptedById], references: [id])
  acceptedById String?

  invitedAccountId String?

  pickupConfirmedById String?

  pickupContactName  String?
  pickupContactPhone String?

  dropoffContactName  String?
  dropoffContactPhone String?

  deliveryMarkedById String?

  cancelledById String?
  cancelledAt   DateTime?

  paidMarkedById String?
  paidMarkedAt   DateTime?

  receivedConfirmedById String?
  receivedConfirmedAt   DateTime?

  bids Bid[]
  driverAssignment JobDriverAssignment?

  ratings Rating[]

  driverOpportunities DriverOpportunity[]

  createdAt  DateTime      @default(now())
  activities JobActivity[]
  incidentEvidence IncidentEvidence[]
  moderationReports ModerationReport[]

  @@index([status])
  @@index([posterId])
  @@index([acceptedById])
  @@index([vehicleType])
  @@index([createdAt])
  @@index([currency, status])
}

model Bid {
  id String @id @default(cuid())

  job   Job    @relation(fields: [jobId], references: [id])
  jobId String

  bidder   Account @relation(fields: [bidderId], references: [id])
  bidderId String

  amount Float

  status BidStatus @default(active)

  // Fleet bids declare the driver and vehicle up front; copied to the job on award.
  fleetDriverName         String?
  fleetDriverLicenceHash  String?
  fleetDriverLicenceLast4 String?
  fleetVehicleId          String?

  createdAt DateTime @default(now())

  @@index([jobId])
  @@index([bidderId])
}

model Referral {
  id String @id @default(cuid())

  referrer   Account @relation("Referrer", fields: [referrerId], references: [id])
  referrerId String

  referredAccount   Account @relation("ReferredAccount", fields: [referredAccountId], references: [id])
  referredAccountId String  @unique

  status ReferralStatus @default(pending)

  // Registration was successfully verified.
  verifiedAt DateTime?

  // The referred account completed its first qualifying genuine job.
  qualifyingJobId String?
  qualifyingJobAt DateTime?

  rejectedAt      DateTime?
  rejectionReason String?

  createdAt DateTime @default(now())

  @@index([referrerId, status])
}

model DriverOpportunity {
  id String @id @default(cuid())

  driver   Account @relation(fields: [driverId], references: [id], onDelete: Cascade)
  driverId String

  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  jobId String

  status OpportunityStatus @default(exposed)

  // When this job first became reasonably available to this driver.
  exposedAt DateTime @default(now())

  // Last time the opportunity was visible to the driver.
  lastSeenAt DateTime?

  // Driver actually opened/viewed the job.
  viewedAt DateTime?

  // Driver bid on it.
  bidAt DateTime?

  // Driver accepted it.
  acceptedAt DateTime?

  // Job became unavailable before this driver could reasonably act.
  expiredAt DateTime?

  // Explanation when the opportunity is marked unavailable.
  reason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([driverId, jobId])
  @@index([driverId, status])
  @@index([jobId])
}

model QualificationSnapshot {
  id String @id @default(cuid())

  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accountId String

  side QualificationSide

  cycleNumber Int

  evaluatedAt DateTime @default(now())

  // Normal programme target.
  normalTarget Int

  // Platform-derived fair target.
  adjustedTarget Int

  // Actual completed/achieved amount.
  actualAmount Int

  // Ratio between 0 and 1.
  fairnessRatio Float

  // Marketplace opportunity data used for calculation.
  opportunitiesAvailable Int

  opportunitiesRequired Int

  userParticipationRatio Float?

  qualified    Boolean @default(false)
  graceGranted Boolean @default(false)

  explanation String?

  @@index([accountId, side, cycleNumber])
}

model PlatformUsageEvent {
  id String @id @default(cuid())

  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accountId String

  // Examples:
  // job_accepted
  // job_completed
  // job_posted
  // referral_verified
  // referral_completed
  eventType String

  // Unique business key prevents duplicate counting.
  eventKey String

  // Optional monetary amount in pence.
  amountPence Int?

  metadata Json?

  createdAt DateTime @default(now())

  @@unique([accountId, eventKey])
  @@index([accountId, eventType, createdAt])
}

model JobActivity {
  id String @id @default(cuid())

  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  jobId String

  actor   Account? @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorId String?

  action String

  fromStatus JobStatus?
  toStatus   JobStatus?

  description String?

  metadata Json?

  evidenceFiles IncidentEvidence[]

  createdAt DateTime @default(now())

  @@index([jobId, createdAt])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@index([actorId, action, createdAt])
}


model TesterAccessCode {
  id                 String   @id @default(cuid())
  codeHash           String   @unique
  claimedAt          DateTime?
  claimedByAccountId String?  @unique
  createdAt          DateTime @default(now())
}


model RateLimitBucket {
  // SHA-256 of scope + identity + fixed-window epoch; raw IP/email values are never stored.
  key       String   @id
  count     Int      @default(1)
  expiresAt DateTime

  @@index([expiresAt])
}

model ApiRequestMetric {
  id         String   @id @default(cuid())
  method     String
  route      String
  statusCode Int
  durationMs Int
  // Set only for requests in non-production environments that carry a QA run identifier.
  qaRunId    String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([route, createdAt])
  @@index([statusCode, createdAt])
  @@index([qaRunId, createdAt])
}

// DEPRECATED (2026-11-06): trial-cycle extensions are removed. Rows are retained for audit;
// no code writes this table any more (QA cleanup still deletes QA rows).
model TrialCycle {
  id        String  @id @default(cuid())
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accountId String

  // 0 is the initial three-month period; 1-3 are the three possible extensions.
  cycleNumber Int
  startAt     DateTime
  endAt       DateTime
  graceStartedAt DateTime?
  graceEndsAt    DateTime?

  // active, grace, extended, failed, or max_extensions_complete.
  status String @default("active")

  posterPostedTarget       Int @default(60)
  posterCompletedTarget    Int @default(15)
  driverCompletedTarget    Int @default(30)
  verifiedReferralsTarget  Int @default(15)
  completedReferralsTarget Int @default(5)

  posterPostedActual       Int @default(0)
  posterCompletedActual    Int @default(0)
  driverCompletedActual    Int @default(0)
  verifiedReferralsActual  Int @default(0)
  completedReferralsActual Int @default(0)

  posterAdjustedTarget Int @default(60)
  driverAdjustedTarget Int @default(30)
  posterFairnessRatio  Float @default(1)
  driverFairnessRatio  Float @default(1)

  graceGranted    Boolean   @default(false)
  decision        String?
  decisionAt      DateTime?
  lastEvaluatedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([accountId, cycleNumber])
  @@index([accountId, status])
}


model Notification {
  id        String   @id @default(cuid())
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accountId String

  type      String
  title     String
  body      String
  jobId     String?
  eventKey  String?  @unique
  metadata  Json?
  readAt    DateTime?
  createdAt DateTime @default(now())

  @@index([accountId, readAt, createdAt])
  @@index([jobId, createdAt])
}

model IncidentEvidence {
  id String @id @default(cuid())

  incident   JobActivity @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  incidentId String

  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  jobId String

  uploadedBy   Account @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  uploadedById String

  fileName  String
  mimeType  String
  sizeBytes Int
  sha256    String
  content   Bytes

  createdAt DateTime @default(now())

  @@index([incidentId, createdAt])
  @@index([jobId, createdAt])
}


model AccountBlock {
  id        String   @id @default(cuid())
  blocker   Account  @relation("AccountBlocksCreated", fields: [blockerId], references: [id], onDelete: Cascade)
  blockerId String
  blocked   Account  @relation("AccountBlocksReceived", fields: [blockedId], references: [id], onDelete: Cascade)
  blockedId String
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockedId, createdAt])
}

model ModerationReport {
  id                  String   @id @default(cuid())
  reporter            Account  @relation("ModerationReportReporter", fields: [reporterId], references: [id], onDelete: Restrict)
  reporterId          String
  reportedAccount     Account? @relation("ModerationReportTarget", fields: [reportedAccountId], references: [id], onDelete: SetNull)
  reportedAccountId   String?
  job                 Job?     @relation(fields: [jobId], references: [id], onDelete: SetNull)
  jobId               String?
  reason              String
  details             String?
  status              String   @default("open")
  adminNotes          String?
  reviewer            Account? @relation("ModerationReportReviewer", fields: [reviewerAccountId], references: [id], onDelete: SetNull)
  reviewerAccountId   String?
  createdAt           DateTime @default(now())
  reviewedAt          DateTime?

  @@index([status, createdAt])
  @@index([reporterId, createdAt])
  @@index([reportedAccountId, createdAt])
  @@index([jobId, createdAt])
}

model AdminAuditEvent {
  id         String   @id @default(cuid())
  actor      String
  action     String
  entityType String
  entityId   String?
  market     String?
  details    Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([entityType, entityId])
  @@index([market, createdAt])
}

/// Existing staging QA mapping table; mapped here for SQL-side marketplace exclusion.
/// This is a Prisma client mapping only and does not require a database migration.
model QaTestAccount {
  runId     String  @map("run_id")
  accountId String  @map("account_id")
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@id([runId, accountId])
  @@map("qa_test_accounts")
}

/// One active SMS one-time-code challenge per phone number. Only hashes are
/// stored: the phone as SHA-256, the code peppered with a server secret.
model PhoneOtpChallenge {
  phoneHash  String    @id
  accountId  String
  codeHash   String
  expiresAt  DateTime
  createdAt  DateTime  @default(now())
  attempts   Int       @default(0)
  consumedAt DateTime?

  @@index([accountId])
  @@index([expiresAt])
}

/// Staging-only SMS test outbox. Written only by the sandbox adapter, which is
/// enabled solely behind the isolated staging QA guard. Never used in production.
model SmsSandboxMessage {
  id          String   @id @default(cuid())
  phoneMasked String
  code        String
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  @@index([createdAt])
}
