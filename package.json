{
  "name": "post2drive-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "rm -rf node_modules/.prisma/client && prisma generate --schema=prisma/schema.prisma && next build",
    "start": "next start",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "qa:lifecycle-contract": "node scripts/qa/lifecycle-contract.mjs",
    "qa:market-timezone": "node --experimental-strip-types scripts/qa/market-timezone-contract.mjs",
    "qa:market-isolation": "node --experimental-strip-types scripts/qa/market-isolation-contract.mjs",
    "qa:health-contract": "node scripts/qa/health-contract.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "next": "15.5.27",
    "next-auth": "^4.24.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.5",
    "prisma": "^5.20.0",
    "typescript": "^5.5.4"
  },
  "overrides": {
    "postcss": "^8.5.23",
    "xcode": {
      "uuid": "^11.1.1"
    }
  }
}
