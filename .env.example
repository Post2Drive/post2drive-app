# Copy to .env for local development. Never commit real credentials.
DATABASE_URL="postgresql://user:password@localhost:5432/freightapp"

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# Optional email verification. Keep disabled until Resend and a verified sender are ready.
EMAIL_VERIFICATION_ENABLED="false"
RESEND_API_KEY=""
EMAIL_FROM=""

# Provider-neutral callback secret; this alone is not a payment-provider integration.
# Configure only when a trusted provider adapter is implemented and verified.
SUBSCRIPTION_WEBHOOK_SECRET=""

# Optional admin/tester settings. Use real authorized addresses and a private tester code.
POST2DRIVE_ADMIN_EMAILS=""
POST2DRIVE_TESTER_CODE=""

# Driver licence identity: keyed hash secret (32+ characters). Required in production; licence checks fail closed without it.
POST2DRIVE_LICENCE_HASH_SECRET=""

# Shared secret a daily scheduler sends (header x-scheduler-secret) to POST /api/internal/notifications/run.
# Reminders do not run until this is set and a scheduler is configured.
POST2DRIVE_SCHEDULER_SECRET=""

# QA worker only: name of the isolated QA database. The worker stays idle unless DATABASE_URL targets it.
POST2DRIVE_QA_DATABASE_NAME=""
