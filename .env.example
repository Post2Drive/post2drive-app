# Copy to .env for local development. Never commit real credentials.
DATABASE_URL="postgresql://user:password@localhost:5432/freightapp"

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# Optional email verification. Keep disabled until Resend and a verified sender are ready.
EMAIL_VERIFICATION_ENABLED="false"
RESEND_API_KEY=""
EMAIL_FROM=""

# Provider-neutral test hook for staging only; returns 404 in production.
SUBSCRIPTION_WEBHOOK_SECRET=""

# Subscription checkout (Stripe). Both values are required; with either missing the app says
# "checkout is not connected" and charges nothing. Webhook endpoint: /api/subscription/webhook/stripe
# Events to send: checkout.session.completed, checkout.session.async_payment_succeeded,
# checkout.session.async_payment_failed, checkout.session.expired, charge.refunded
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# SMS codes. Name a carrier per route ("twilio" or "msg91"), then set that carrier's credentials.
POST2DRIVE_SMS_UK_PROVIDER=""
POST2DRIVE_SMS_INDIA_PROVIDER=""
POST2DRIVE_SMS_GLOBAL_PROVIDER=""
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
# One of: a Messaging Service SID (MG...) or a From number / approved sender name.
TWILIO_MESSAGING_SERVICE_SID=""
TWILIO_FROM=""
MSG91_AUTH_KEY=""
# DLT-approved OTP template id from the MSG91 panel.
MSG91_OTP_TEMPLATE_ID=""
# Pepper for stored one-time codes (32+ characters).
POST2DRIVE_OTP_SECRET=""

# "staging" or "production". Production refuses to start if required settings are missing
# or any test switch is on (see lib/providerReadiness.ts).
DEPLOYMENT_ENVIRONMENT=""

# Optional admin/tester settings. Use real authorized addresses and a private tester code.
POST2DRIVE_ADMIN_EMAILS=""
POST2DRIVE_TESTER_CODE=""

# Driver licence identity: keyed hash secret (32+ characters). Required in production; licence checks fail closed without it.
POST2DRIVE_LICENCE_HASH_SECRET=""

# Shared secret a daily scheduler sends (header x-scheduler-secret) to POST /api/internal/notifications/run.
# Reminders do not run until this is set and a scheduler is configured.
POST2DRIVE_SCHEDULER_SECRET=""

# QA worker only: name of the isolated QA database. The worker stays idle unless DATABASE_URL targets it.
POST2DRIVE_QA_DATABASE_NAME=""
