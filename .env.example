# Copy to .env for local development. Never commit real credentials.
DATABASE_URL="postgresql://user:password@localhost:5432/freightapp"

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# Optional email verification. Keep disabled until Resend and a verified sender are ready.
EMAIL_VERIFICATION_ENABLED="false"
RESEND_API_KEY=""
EMAIL_FROM=""

# Provider-neutral callback secret; this alone is not a payment-provider integration.
# Configure only when a trusted provider adapter is implemented and verified.
SUBSCRIPTION_WEBHOOK_SECRET=""

# Optional admin/tester settings. Use real authorized addresses and a private tester code.
POST2DRIVE_ADMIN_EMAILS=""
POST2DRIVE_TESTER_CODE=""
